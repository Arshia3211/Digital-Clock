{
  "name": "tick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A clock whose world tracks the sun.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "font": "node scripts/build-font.mjs",
    "shoot": "node scripts/shoot.mjs",
    "verify": "node scripts/verify.mjs",
    "soak": "node scripts/soak.mjs",
    "check": "npm run typecheck && npm run test && npm run shoot && npm run verify"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@react-three/fiber": "^8.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "opentype.js": "^1.3.4",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
